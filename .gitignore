# Repository allowlist: source, documentation, and robot simulation assets only.
/*

# Root project files
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/MUJOCO.md
!/CLOSED_LOOP_SEARCH.md
!/SINGULARITY_GRAPH_PIPELINE_2026.md
!/requirements.txt
!/environment.yml
!/pyproject.toml
!/setup.cfg
!/LICENSE*

# Python source
!/src/
/src/**
!/src/**/
!/src/**/*.py

!/scripts/
/scripts/**
!/scripts/**/
!/scripts/**/*.py
!/scripts/README.md

!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py

# Research notes
!/notebooks/
/notebooks/**
!/notebooks/*.ipynb

# Private robot assets and research data stay local. Only the placeholder is public.
!/data/
/data/**
!/data/README.md

# Secrets and machine-local configuration
.env*
!.env.example
*.pem
*.key
*credentials*
*secrets*
.idea/
.vscode/
.sisyphus/
.opencode/

# Python and tool caches
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and local runtime state
.venv/
venv/
env/
*.log

